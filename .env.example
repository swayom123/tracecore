TRACECORE_DATA_MODE=live
TRACECORE_DATABASE_URL=sqlite:///./tracecore.db
TRACECORE_MAX_PAYLOAD_BYTES=1048576
TRACECORE_LOGGING_MODE=REDACTED
TRACECORE_LOG_LEVEL=INFO
TRACECORE_RUNTIME_ENVIRONMENT=development
TRACECORE_AUTH_MODE=development
# In production set AUTH_MODE=bearer. Use API_TOKENS as a bootstrap credential; issue revocable
# scoped credentials through POST /auth/tokens after migrations. Keep bootstrap material in secrets.
# TRACECORE_API_TOKENS={"<long-random-token>":{"subject":"operator","role":"ADMIN","organization_id":"org-1","project_ids":["project-1"],"environments":["production"]}}
TRACECORE_RATE_LIMIT_PER_MINUTE=600
# Retention is applied by scheduling `tracecore retention enforce --project-id PROJECT_ID`.
TRACECORE_RETENTION_DAYS_BY_ENVIRONMENT={"development":30,"staging":60,"production":90}
# Optional JSON array of organization-specific regular expressions to redact.
TRACECORE_REDACTION_PATTERNS=[]
TRACECORE_MONITORING_PERCENTILE_MIN_SAMPLES=20

# Model-based evaluation is disabled unless this allowlist includes the provider.
# Never enable FULL_CONTENT or a provider without reviewing its data handling terms.
TRACECORE_EVALUATION_ALLOWED_PROVIDERS=
TRACECORE_EVALUATION_RESTRICTED_DATA_PROVIDERS=
TRACECORE_EVALUATION_OPENAI_BASE_URL=https://api.openai.com/v1
# TRACECORE_EVALUATION_OPENAI_API_KEY=

